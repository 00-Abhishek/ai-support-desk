# Copy to .env and adjust. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_desk
# Used by the backend. Host is "db" inside docker-compose, "localhost" locally.
DATABASE_URL=postgresql+psycopg://support:support@db:5432/support_desk

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Optional AI ---
# Keep AI_PROVIDER=stub to run fully offline with no API key.
AI_ENABLED=true
AI_PROVIDER=stub
AI_MODEL=stub-heuristic-v1
OPENAI_API_KEY=
